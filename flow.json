 {"id":"fn_split","type":"function","z":"flow1","name":"separa dados","func":"const d = msg.payload;\nconst v = d.velocidade;\nconst dist = d.distancia;\nreturn [\n  {payload: v},\n  {payload: dist >= 999 ? 'Sem obstáculo' : dist.toFixed(0) + ' cm'},\n  {payload: d.ldr},\n  {payload: d.farois ? '💡 Ligados' : '⚫ Desligados'},\n  [{topic: 'Velocidade (km/h)', payload: v}, {topic: 'Distância (cm)', payload: Math.min(dist, 200)}],\n  msg,\n  {payload: '🟢 Recebendo dados • ' + new Date().toLocaleTimeString('pt-BR')}\n];","outputs":7,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":290,"y":160,"wires":[["g_vel"],["t_dist"],["t_ldr"],["t_far"],["ch1"],["fn_alert"],["t_com"]]},

