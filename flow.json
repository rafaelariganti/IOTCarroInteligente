 {"id":"fn_alert","type":"function","z":"flow1","name":"gera alertas","func":"const d = msg.payload;\nlet alerta = '✅ Sem alertas';\nif (d.obstaculo) alerta = '🚨 Obstáculo detectado (≤ 20 cm) - frenagem de emergência';\nelse if (d.velocidade >= 100) alerta = '⚠️ Velocidade alta';\nelse if (d.freio) alerta = '🛑 Freio remoto ativo';\nconst anterior = flow.get('ultimoAlerta');\nflow.set('ultimoAlerta', alerta);\nconst novo = alerta !== '✅ Sem alertas' && alerta !== anterior;\nreturn [{payload: alerta}, novo ? {payload: alerta, topic: 'ALERTA'} : null];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":290,"y":300,"wires":[["t_alert"],["toast1"]]},
